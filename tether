def cmd_init(policy: Policy) -> None:
    reg = Registry(policy.state_dir)
    minted = init_caps(policy, reg)
    for session in policy.session_names:
        state = "minted" if session in minted else "kept"
        log(f"{state} {policy.state_dir / (session + '.env')}")
    for name in policy.disabled_routes:
        log(f"route /{name}/ disabled: its credential did not resolve")


def fmt_ts(t: float | None) -> str:
    return dt.datetime.fromtimestamp(t).astimezone().isoformat(timespec="seconds") if t else "-"


def cmd_cap(policy: Policy, args: argparse.Namespace) -> None:
    reg = Registry(policy.state_dir)
    if args.cap_cmd == "mint":
        sandbox = args.sandbox or policy.session_sandbox.get(args.session)
        if sandbox not in policy.sandboxes:
            raise SystemExit(f"tether: no sandbox {sandbox!r} (session {args.session!r} is in none)")
        if args.session not in policy.sandboxes[sandbox].sessions:
            raise SystemExit(f"tether: session {args.session!r} is not in sandbox {sandbox!r}")
        unknown = [r for r in args.route or [] if r not in policy.routes]
        if unknown:
            raise SystemExit(f"tether: no such route(s): {', '.join(unknown)}")
        cap, rec = reg.mint(
            sandbox,
            args.session,
            agent=args.agent,
            tool=args.tool,
            human=args.human,
            routes=args.route,
            egress=[h.lower() for h in args.egress] if args.egress else None,
            spend_usd=args.spend,
            ttl_secs=parse_ttl(args.ttl) if args.ttl else None,
        )
        if args.env:
            write_env_file(policy, args.env, cap, rec)
            log(f"minted {rec['cap_id']} for sandbox {sandbox}, wrote {args.env}")
        else:
            log(f"minted {rec['cap_id']} for sandbox {sandbox}")
            print(cap)
    elif args.cap_cmd == "revoke":
        if not (args.cap_id or args.sandbox or args.session):
            raise SystemExit("tether: name cap ids, --sandbox or --session")
        ids = set(args.cap_id)

        def match(r: dict[str, Any]) -> bool:
            return (
                (not ids or r["cap_id"] in ids)
                and (not args.sandbox or r["sandbox"] == args.sandbox)
                and (not args.session or r["session"] == args.session)
            )

        gone = reg.revoke(match)
        for r in gone:
            log(f"revoked {r['cap_id']} ({r['sandbox']}/{r['session']})")
        if not gone:
            raise SystemExit("tether: no live capability matched")
    elif args.cap_cmd == "boot":
        if args.sandbox not in policy.sandboxes:
            raise SystemExit(f"tether: no sandbox {args.sandbox!r}")
        for session in init_caps(policy, reg, [args.sandbox], rotate=True):
            log(f"minted {policy.state_dir / (session + '.env')}")
    else:
        now = time.time()
        rows = [r for r in reg.records() if args.all or cap_state(r, now) == "live"]
        if args.json:
            print(json.dumps([{**r, "state": cap_state(r, now)} for r in rows], indent=2))
            return
        print(f"{'CAP':<16} {'STATE':<8} {'SANDBOX':<12} {'SESSION':<12} {'AGENT':<10} {'TOOL':<8} EXPIRES")
        for r in rows:
            print(
                f"{r['cap_id']:<16} {cap_state(r, now):<8} {r['sandbox']:<12} {r['session']:<12} "
                f"{r.get('agent') or '-':<10} {r.get('tool') or '-':<8} {fmt_ts(r.get('expires'))}"
            )


def cmd_serve(policy: Policy) -> None:
    init_caps(policy, Registry(policy.state_dir))
    srvs, gw = build_servers(policy)
    for name, sb in policy.sandboxes.items():
        sessions = ", ".join(sb.sessions)
        log(f"sandbox {name}: listening on {sb.listen}, advertised as {sb.advertise}, sessions {sessions}")
    log(f"routes: {', '.join('/' + n + '/' for n in policy.routes) or 'none'}")
    for name in policy.disabled_routes:
        log(f"route /{name}/ disabled: its credential did not resolve")
    log(f"egress allowlist: {' '.join(policy.egress_allow) or '(nothing)'}")
    caps = []
    if policy.cap_session is not None:
        caps.append(f"${policy.cap_session:.2f}/session/day")
    if policy.cap_total is not None:
        caps.append(f"${policy.cap_total:.2f}/team/day")
    log(f"spend caps: {', '.join(caps) or 'none'}")
    *rest, main_srv = srvs.values()
    for s in rest:
        threading.Thread(target=s.serve_forever, daemon=True).start()
    try:
        main_srv.serve_forever()
    except KeyboardInterrupt:
        log("stopped -- every capability is inert until the gateway is back")


def cmd_report(policy: Policy, as_json: bool) -> None:
    f = policy.state_dir / "audit.jsonl"
    if not f.exists():
        print("no audit log yet")
        return
    day = today()
    rows: dict[str, dict[str, Any]] = defaultdict(
        lambda: {"requests": 0, "denied": 0, "usd_today": 0.0, "in": 0, "out": 0, "models": Counter(), "last": ""}
    )
    denied_hosts: Counter[str] = Counter()
    for line in f.read_text().splitlines():
        try:
            r = json.loads(line)
        except ValueError:
            continue
        s = rows[r.get("session", "-")]
        s["requests"] += 1
        s["last"] = max(s["last"], r.get("ts", ""))
        if r.get("decision") == "deny":
            s["denied"] += 1
            denied_hosts[r.get("host") or f"/{r.get('route')}{r.get('path', '')}"] += 1
        if r.get("ts", "").startswith(day) and r.get("usd"):
            s["usd_today"] += r["usd"]
        t = r.get("tokens") or {}
        s["in"] += t.get("in", 0) + t.get("cw", 0) + t.get("cr", 0)
        s["out"] += t.get("out", 0)
        if r.get("model"):
            s["models"][r["model"]] += 1
    if as_json:
        print(json.dumps({k: {**v, "models": dict(v["models"])} for k, v in rows.items()}, indent=2))
        return
    cap = f" / ${policy.cap_session:.2f}" if policy.cap_session is not None else ""
    print(f"{'SESSION':<20} {'REQS':>5} {'DENIED':>6} {'TOKENS IN/OUT':>16} {'SPEND TODAY':>18}  LAST SEEN")
    for name, s in sorted(rows.items()):
        toks = f"{s['in']}/{s['out']}"
        spend = f"${s['usd_today']:.4f}{cap if name != '-' else ''}"
        print(f"{name:<20} {s['requests']:>5} {s['denied']:>6} {toks:>16} {spend:>18}  {s['last'][11:19]}")
    if denied_hosts:
        print("\nmost refused:")
        for h, n in denied_hosts.most_common(8):
            print(f"  {n:>4}  {h}")


def main(argv: list[str] | None = None) -> None:
    ap = argparse.ArgumentParser(prog="tether", description=__doc__.split("\n\n")[0])
    ap.add_argument("-c", "--config", default="policy.json", type=Path)
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("init", help="mint a default cap per session and write run/tether/<session>.env")
    sub.add_parser("serve", help="run the gateway")
    rp = sub.add_parser("report", help="spend and denials per session")
    rp.add_argument("--json", action="store_true")
    cp = sub.add_parser("cap", help="mint, revoke and list capabilities")
    csub = cp.add_subparsers(dest="cap_cmd", required=True)
    m = csub.add_parser("mint", help="mint a cap; prints it (or writes --env) once")
    m.add_argument("--session", required=True)
    m.add_argument("--sandbox", help="default: the session's sandbox")
    m.add_argument("--agent")
    m.add_argument("--tool")
    m.add_argument("--human")
    m.add_argument("--route", action="append", help="limit to this route (repeatable)")
    m.add_argument("--egress", action="append", help="limit to this host pattern (repeatable)")
    m.add_argument("--spend", type=float, help="spend sub-cap, USD per day")
    m.add_argument("--ttl", help="lifetime, e.g. 90s, 30m, 8h, 2d")
    m.add_argument("--env", type=Path, help="write an env file (0600) instead of printing the cap")
    r = csub.add_parser("revoke", help="revoke caps; takes effect on the next request")
    r.add_argument("cap_id", nargs="*")
    r.add_argument("--sandbox")
    r.add_argument("--session")
    b = csub.add_parser("boot", help="new boot: revoke every cap of a sandbox, mint fresh session caps")
    b.add_argument("sandbox")
    ls = csub.add_parser("list", help="caps and their state (never the caps themselves)")
    ls.add_argument("--all", action="store_true", help="include revoked and expired")
    ls.add_argument("--json", action="store_true")
    args = ap.parse_args(argv)
    policy = Policy(args.config)
    if args.cmd == "init":
        cmd_init(policy)
    elif args.cmd == "serve":
        cmd_serve(policy)
    elif args.cmd == "cap":
        cmd_cap(policy, args)
    else:
        cmd_report(policy, args.json)


if __name__ == "__main__":
    main()
