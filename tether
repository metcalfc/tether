def resolve_credential(spec: str) -> str:
    """env:NAME, cmd:<shell>, file:PATH. Read once, at start, outside the VM.

    cmd: is the macOS-keychain / 1Password hook, e.g.
      cmd:security find-generic-password -s anthropic -w
      cmd:op read op://dev/anthropic/credential
    """
    if spec.startswith("env:"):
        return os.environ.get(spec[4:], "").strip()
    if spec.startswith("cmd:"):
        r = subprocess.run(spec[4:], shell=True, capture_output=True, text=True)
        return r.stdout.strip() if r.returncode == 0 else ""
    if spec.startswith("file:"):
        p = Path(spec[5:]).expanduser()
        return p.read_text().strip() if p.exists() else ""
    return ""


class Route:
    def __init__(self, name: str, cfg: dict[str, Any]) -> None:
        self.name = name
        self.upstream = urllib.parse.urlsplit(cfg["upstream"])
        self.inject: str = cfg.get("inject", "bearer")
        self.paths: list[str] = cfg.get("paths", ["/*"])
        self.meter = bool(cfg.get("meter", False))
        self.credential = resolve_credential(cfg.get("credential", ""))

    @property
    def host(self) -> str:
        return (self.upstream.hostname or "").lower()

    def allowed(self, path: str) -> bool:
        return any(fnmatch.fnmatchcase(path, p) for p in self.paths)

    def apply(self, headers: dict[str, str]) -> None:
        c = self.credential
        if self.inject == "anthropic":
            if c.startswith("sk-ant-oat"):
                headers["authorization"] = "Bearer " + c
                betas = [b.strip() for b in headers.get("anthropic-beta", "").split(",") if b.strip()]
                for b in OAUTH_BETAS:
                    if b not in betas:
                        betas.append(b)
                headers["anthropic-beta"] = ",".join(betas)
            else:
                headers["x-api-key"] = c
        elif self.inject == "bearer":
            headers["authorization"] = "Bearer " + c
        elif self.inject.startswith("basic:"):
            user = self.inject.split(":", 1)[1]
            headers["authorization"] = "Basic " + base64.b64encode(f"{user}:{c}".encode()).decode()
        else:
            raise ValueError(f"route {self.name}: unknown inject mode {self.inject!r}")


class Sandbox:
    """One machine, one listener. The port a request arrives on says which
    sandbox sent it: the guest can't choose it, so it can't forge it."""

    def __init__(self, name: str, listen: str, advertise: str, sessions: list[str]) -> None:
        self.name = name
        self.listen = listen
        self.advertise = advertise
        self.sessions = sessions


class Policy:
    def __init__(self, path: Path) -> None:
        self.path = path
        raw = path.read_bytes()
        cfg = json.loads(raw)
        # Which policy decided: every audit line names it.
        self.version = hashlib.sha256(raw).hexdigest()[:12]
        base = path.parent
        self.listen: str = cfg.get("listen", "0.0.0.0:8080")
        self.advertise: str = cfg.get("advertise", "http://tether:8080")
        self.state_dir = (base / cfg.get("state_dir", "run/tether")).resolve()
        # Without a `sandboxes` map, the top-level listen/advertise/sessions
        # are one sandbox called "default" -- leash's single-listener shape.
        self.sandboxes: dict[str, Sandbox] = {}
        if "sandboxes" in cfg:
            if "sessions" in cfg:
                raise ValueError("policy: list sessions under each sandbox, not at the top level")
            for name, sc in cfg["sandboxes"].items():
                listen = sc["listen"]
                port = listen.rpartition(":")[2]
                adv = sc.get("advertise", f"http://host.microsandbox.internal:{port}")
                self.sandboxes[name] = Sandbox(name, listen, adv, sc.get("sessions", [name]))
        else:
            sessions = cfg.get("sessions", ["default"])
            self.sandboxes["default"] = Sandbox("default", self.listen, self.advertise, sessions)
        self.session_sandbox: dict[str, str] = {}
        for sb in self.sandboxes.values():
            for s in sb.sessions:
                if s in self.session_sandbox:
                    raise ValueError(f"policy: session {s} is in sandboxes {self.session_sandbox[s]} and {sb.name}")
                self.session_sandbox[s] = sb.name
        self.session_names: list[str] = list(self.session_sandbox)
        self.routes: dict[str, Route] = {}
        self.disabled_routes: list[str] = []
        for name, rc in cfg.get("routes", {}).items():
            r = Route(name, rc)
            if r.credential:
                self.routes[name] = r
            else:
                self.disabled_routes.append(name)
        eg = cfg.get("egress", {})
        self.egress_allow: list[str] = [h.lower() for h in eg.get("allow", [])]
        self.egress_ports: set[int] = set(eg.get("ports", [443]))
        # Non-global addresses (loopback, RFC 1918, link-local, CGNAT, ULA...)
        # a name may resolve to anyway: the host's own networks, opted into.
        self.egress_addresses = [ipaddress.ip_network(c, strict=False) for c in eg.get("allow_addresses", [])]
        sp = cfg.get("spend", {})
        self.cap_session: float | None = sp.get("per_session_usd_per_day")
        self.cap_total: float | None = sp.get("total_usd_per_day")
        self.max_inflight: int = int(sp.get("max_inflight", 4))
        self.prices: dict[str, list[float]] = cfg.get("prices_per_mtok", {"default": [5, 25]})
        # From `tether compile`: what each agent's cap and each of its tools' caps may do.
        self.grants: dict[str, Any] = cfg.get("grants", {})


# ------------------------------------------------------- capability registry

CAP_PREFIX = "tth_"


def cap_hash(cap: str) -> str:
    return hashlib.sha256(cap.encode()).hexdigest()


def cap_state(rec: dict[str, Any], now: float | None = None) -> str:
    if rec.get("revoked"):
        return "revoked"
    exp = rec.get("expires")
    if exp is not None and (now if now is not None else time.time()) >= exp:
        return "expired"
    return "live"


def parse_ttl(s: str) -> float:
    """90s, 30m, 8h, 2d -> seconds."""
    units = {"s": 1, "m": 60, "h": 3600, "d": 86400}
    if not s or s[-1] not in units:
        raise ValueError(f"bad ttl {s!r}: use e.g. 90s, 30m, 8h, 2d")
    return float(s[:-1]) * units[s[-1]]


def pattern_within(pat: str, ceiling: str) -> bool:
    """Does every host `pat` matches also match `ceiling`? Exact for a literal
    host. A `*` in `pat` must be covered by a `*` in the ceiling, which only
    holds when the ceiling has no `?` or `[...]` (a `?` would let one `*` in).
    """
    if pat == ceiling:
        return True
    if "*" in pat and ("?" in ceiling or "[" in ceiling):
        return False
    return fnmatch.fnmatchcase(pat, ceiling)


def grant_errors(
    policy: Policy, routes: list[str] | None, egress: list[str] | None, spend_usd: float | None
) -> list[str]:
    """Why a cap's grants don't fit inside the ceiling (empty if they do).
    Serve enforces both layers anyway; this refuses a cap that promises more
    than it can ever get."""
    errs = [f"no such route: {r}" for r in routes or [] if r not in policy.routes]
    for pat in egress or []:
        if any(c in pat for c in "?[]"):
            errs.append(f"egress {pat}: use literal hosts or * only")
        elif not any(pattern_within(pat, c) for c in policy.egress_allow):
            errs.append(f"egress {pat} is wider than the ceiling ({' '.join(policy.egress_allow) or 'nothing'})")
    if spend_usd is not None:
        if spend_usd < 0:
            errs.append("spend sub-cap must not be negative")
        elif policy.cap_session is not None and spend_usd > policy.cap_session:
            errs.append(f"spend sub-cap ${spend_usd:.2f} is above the session cap ${policy.cap_session:.2f}")
    return errs


class Registry:
    """Every capability tether has minted: which sandbox it is bound to, who
    holds it (session / agent / tool / human) and what it may do. Kept in
    state_dir/caps.json (0600), keyed by the cap's sha256, so the file never
    holds a usable cap. The CLI writes it; `serve` re-reads it whenever it
    changes, so `tether cap revoke` bites on the next request."""

    def __init__(self, state_dir: Path) -> None:
        state_dir.mkdir(parents=True, exist_ok=True)
        self.path = state_dir / "caps.json"
        self.lockfile = state_dir / "caps.lock"
        self.lock = threading.Lock()
        self.sig: tuple[int, int, int] | None = None
        self.by_hash: dict[str, dict[str, Any]] = {}

    def _sig(self) -> tuple[int, int, int] | None:
        try:
            st = self.path.stat()
        except FileNotFoundError:
            return None
        return st.st_ino, st.st_mtime_ns, st.st_size

    def _load(self) -> None:
        # Writers replace the file, so a new inode means new contents: one
        # stat per request is the whole cost of live revocation.
        sig = self._sig()
        if sig != self.sig:
            self.by_hash = json.loads(self.path.read_text()).get("caps", {}) if sig else {}
            self.sig = sig

    def lookup(self, cap: str) -> dict[str, Any] | None:
        with self.lock:
            self._load()
            return self.by_hash.get(cap_hash(cap))

    def records(self) -> list[dict[str, Any]]:
        with self.lock:
            self._load()
            return sorted(self.by_hash.values(), key=lambda r: r["minted"])

    @contextlib.contextmanager
    def _edit(self) -> Iterator[dict[str, dict[str, Any]]]:
        with self.lockfile.open("a") as lf:
            fcntl.flock(lf, fcntl.LOCK_EX)
            caps = json.loads(self.path.read_text()).get("caps", {}) if self.path.exists() else {}
            yield caps
            tmp = self.path.with_suffix(".tmp")
            tmp.write_text(json.dumps({"caps": caps}, indent=2))
            tmp.chmod(0o600)
            os.replace(tmp, self.path)

    def mint(
        self,
        sandbox: str,
        session: str,
        agent: str | None = None,
        tool: str | None = None,
        human: str | None = None,
        routes: list[str] | None = None,
        egress: list[str] | None = None,
        spend_usd: float | None = None,
        ttl_secs: float | None = None,
    ) -> tuple[str, dict[str, Any]]:
        """A new cap and its record. The cap itself is returned once and
        stored nowhere but where the caller puts it."""
        cap = CAP_PREFIX + secrets.token_urlsafe(24)
        now = time.time()
        rec: dict[str, Any] = {
            "cap_id": "cap_" + secrets.token_hex(6),
            "sandbox": sandbox,
            "session": session,
            "agent": agent,
            "tool": tool,
            "human": human,
            # None means "whatever the ceiling allows"; narrowing is per-cap policy.
            "routes": routes,
            "egress": egress,
            "spend_usd": spend_usd,
            "minted": now,
            "expires": now + ttl_secs if ttl_secs else None,
            "revoked": None,
        }
        with self._edit() as caps:
            caps[cap_hash(cap)] = rec
        return cap, rec

    def revoke(self, match: Callable[[dict[str, Any]], bool]) -> list[dict[str, Any]]:
        out = []
        with self._edit() as caps:
            for rec in caps.values():
                if cap_state(rec) != "revoked" and match(rec):
                    rec["revoked"] = time.time()
                    out.append(rec)
        return out


def env_for(
    policy: Policy,
    cap: str,
    advertise: str | None = None,
    routes: list[str] | None = None,
    egress: list[str] | None = None,
) -> dict[str, str]:
    """What the agent's machine gets. Nothing in here is a credential: each
    value is worthless anywhere but through this gateway, on its own
    sandbox's listener. `routes` and `egress` are the cap's grants (None:
    the whole policy), so a tool's env names only what its cap can use: no
    proxy for a cap with no egress, no git rewrite for a cap without github."""
    advertise = advertise or policy.advertise
    adv = urllib.parse.urlsplit(advertise)
    host = adv.netloc
    authed = f"{adv.scheme}://agent:{cap}@{host}"
    env = {"TETHER_CAPABILITY": cap}
    if egress is None or egress:
        for k in ("HTTPS_PROXY", "HTTP_PROXY", "https_proxy", "http_proxy"):
            env[k] = authed
    env["NO_PROXY"] = env["no_proxy"] = adv.hostname or ""
    granted = [r for r in policy.routes if routes is None or r in routes]
    if "anthropic" in granted:
        # Claude Code otherwise phones home for telemetry and updates, which
        # the allowlist would refuse -- noise in the audit log, not a threat.
        env["CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC"] = "1"
        env["ANTHROPIC_BASE_URL"] = f"{advertise}/anthropic"
        env["ANTHROPIC_AUTH_TOKEN"] = cap
    if "openai" in granted:
        env["OPENAI_BASE_URL"] = f"{advertise}/openai/v1"
        env["OPENAI_API_KEY"] = cap
    if "github" in granted:
        # git sees https://github.com/... and quietly talks to the gateway.
        env["GIT_CONFIG_COUNT"] = "1"
        env["GIT_CONFIG_KEY_0"] = f"url.{authed}/github/.insteadOf"
        env["GIT_CONFIG_VALUE_0"] = "https://github.com/"
    if "github-api" in granted:
        env["GH_HOST"] = "github.com"
        env["GITHUB_API_URL"] = f"{advertise}/github-api"
    return env


CAP_FORMATS = ("env", "gitconfig", "npmrc")


def cap_file_body(policy: Policy, cap: str, rec: dict[str, Any], fmt: str = "env") -> str:
    """A cap in the shape its consumer reads. `env` is leash's env file. The
    tool formats are files a tool reads itself, for a sandbox (nono) that can
    grant one file to one tool but not put a secret in its environment:
    `gitconfig` (git -c include.path=...) carries the cap in an
    http.extraHeader rather than in URL userinfo, because git hands the
    rewritten URL to git-remote-http as argv, and /proc/<pid>/cmdline is
    readable by every process; `npmrc` (npm --userconfig ...) sets npm's
    proxy, which npm uses in-process."""
    sb = policy.sandboxes[rec["sandbox"]]
    adv = urllib.parse.urlsplit(sb.advertise)
    routes, egress = rec.get("routes"), rec.get("egress")
    if fmt == "gitconfig":
        if "github" not in policy.routes or (routes is not None and "github" not in routes):
            raise ValueError("a gitconfig cap needs the github route")
        base = f"{sb.advertise}/github/"
        auth = base64.b64encode(f"agent:{cap}".encode()).decode()
        return (
            f'[url "{base}"]\n\tinsteadOf = https://github.com/\n'
            f'[http "{base}"]\n\textraHeader = Authorization: Basic {auth}\n'
        )
    if fmt == "npmrc":
        if egress is not None and not egress:
            raise ValueError("an npmrc cap needs an egress grant")
        authed = f"{adv.scheme}://agent:{cap}@{adv.netloc}"
        return f"https-proxy={authed}\nproxy={authed}\nnoproxy={adv.hostname}\n"
    env = env_for(policy, cap, sb.advertise, routes, egress)
    return "\n".join(f"{k}={v}" for k, v in env.items()) + "\n"


def write_env_file(policy: Policy, path: Path, cap: str, rec: dict[str, Any], fmt: str = "env") -> Path:
    sb = policy.sandboxes[rec["sandbox"]]
    who = "/".join(x for x in (rec["session"], rec.get("agent"), rec.get("tool")) if x)
    body = cap_file_body(policy, cap, rec, fmt).rstrip("\n")
    mark = ";" if fmt == "npmrc" else "#"
    head = f"{mark} tether {rec['cap_id']} for {who} (sandbox {sb.name}) -- capabilities only, no credentials"
    if str(path) == "-":
        # Straight into a pipe (e.g. into the guest), so the cap is never on the host's disk.
        sys.stdout.write(f"{head}\n{body}\n")
        sys.stdout.flush()
        return path
    path.write_text(f"{head}\n{body}\n")
    path.chmod(0o600)
    return path


def env_file_cap(path: Path) -> str:
    if path.exists():
        for line in path.read_text().splitlines():
            if line.startswith("TETHER_CAPABILITY="):
                return line.partition("=")[2]
    return ""


def init_caps(
    policy: Policy, reg: Registry, sandboxes: list[str] | None = None, rotate: bool = False
) -> dict[str, str]:
    """One default cap per session (no agent, no tool), delivered as
    state_dir/<session>.env -- leash's shape. Idempotent: a session whose env
    file still holds a live cap keeps it. With `rotate` (a new boot), every
    cap of those sandboxes is revoked first and fresh ones are minted.
    Returns session -> cap for the caps minted now."""
    names = sandboxes or list(policy.sandboxes)
    if rotate:
        reg.revoke(lambda r: r["sandbox"] in names)
    out: dict[str, str] = {}
    for sb in names:
        for session in policy.sandboxes[sb].sessions:
            f = policy.state_dir / f"{session}.env"
            rec = reg.lookup(env_file_cap(f) or "-")
            if rec and cap_state(rec) == "live" and (rec["sandbox"], rec["session"]) == (sb, session):
                continue

            def stale(r: dict[str, Any], s: str = session) -> bool:
                return r["session"] == s and not r.get("agent") and not r.get("tool")

            reg.revoke(stale)
            cap, rec = reg.mint(sb, session)
            write_env_file(policy, f, cap, rec)
            out[session] = cap
    return out


# ------------------------------------------------------------ ledger & audit


class Reservation:
    """An estimate held against the caps while a metered call is in flight."""

    def __init__(self, session: str, cap_id: str | None, usd: float) -> None:
        self.session = session
        self.cap_id = cap_id
        self.usd = usd
        self.open = True


class Ledger:
    """Today's spend per session, and per cap for caps with a sub-cap.
    Charged totals are persisted so a restart doesn't reset a cap.
    Reservations and in-flight counts live in memory only: nothing is in
    flight across a restart."""

    def __init__(self, path: Path) -> None:
        self.path = path
        self.lock = threading.Lock()
        self.day = today()
        self.spent: dict[str, float] = {}
        # Kept apart from `spent`, so the team total doesn't count a call twice.
        self.cap_spent: dict[str, float] = {}
        self.held: dict[str, float] = {}
        self.cap_held: dict[str, float] = {}
        self.inflight: dict[str, int] = {}
        if path.exists():
            d = json.loads(path.read_text())
            if d.get("day") == self.day:
                self.spent = d.get("spent", {})
                self.cap_spent = d.get("caps", {})

    def _roll(self) -> None:
        # Holds survive the roll: those calls settle into the new day.
        if self.day != today():
            self.day, self.spent, self.cap_spent = today(), {}, {}

    def totals(self, session: str) -> tuple[float, float]:
        with self.lock:
            self._roll()
            return self.spent.get(session, 0.0), sum(self.spent.values())

    def cap_total(self, cap_id: str) -> float:
        with self.lock:
            self._roll()
            return self.cap_spent.get(cap_id, 0.0)

    def reserve(
        self,
        session: str,
        est: float,
        session_cap: float | None,
        team_cap: float | None,
        max_inflight: int,
        cap_id: str | None = None,
        sub_cap: float | None = None,
    ) -> tuple[Reservation | None, str | None, str]:
        """Admit a call costing up to `est`, or say why not and which limit
        (the audit's `rule`). Checked and held
        under one lock, so concurrent calls can't all fit in the same gap:
        overshoot is bounded by what a call costs beyond its own estimate."""
        with self.lock:
            self._roll()
            n = self.inflight.get(session, 0)
            if n >= max_inflight:
                why = f"{n} calls already in flight for session {session} (max_inflight {max_inflight})"
                return None, why, "spend:max-inflight"
            checks: list[tuple[str, str, str, float, float, float]] = []
            if session_cap is not None:
                spent, held = self.spent.get(session, 0.0), self.held.get(session, 0.0)
                checks.append(("cap", "spend:session", f"session {session}", spent, held, session_cap))
            if team_cap is not None:
                team, team_held = sum(self.spent.values()), sum(self.held.values())
                checks.append(("cap", "spend:team", "the team", team, team_held, team_cap))
            if cap_id is not None and sub_cap is not None:
                spent, held = self.cap_spent.get(cap_id, 0.0), self.cap_held.get(cap_id, 0.0)
                checks.append(("sub-cap", "spend:sub-cap", f"capability {cap_id}", spent, held, sub_cap))
            for kind, rule, whom, spent, held, limit in checks:
                if spent >= limit:
                    return None, f"daily spend {kind} reached for {whom} (${spent:.4f} of ${limit:.4f})", rule
                if spent + held >= limit or spent + held + est > limit:
                    why = (
                        f"daily spend {kind} for {whom} would be crossed (${spent:.4f} spent"
                        f" + ${held:.4f} reserved in flight + ${est:.4f} for this call > ${limit:.4f})"
                    )
                    return None, why, rule
            r = Reservation(session, cap_id if sub_cap is not None else None, est)
            self.inflight[session] = n + 1
            self.held[session] = self.held.get(session, 0.0) + est
            if r.cap_id:
                self.cap_held[r.cap_id] = self.cap_held.get(r.cap_id, 0.0) + est
            return r, None, "spend:admit"

    def settle(self, r: Reservation, usd: float) -> None:
        """Replace a reservation with what the call cost. Idempotent."""
        with self.lock:
            if not r.open:
                return
            r.open = False
            self._roll()
            self.inflight[r.session] = self.inflight.get(r.session, 1) - 1
            self.held[r.session] = max(0.0, self.held.get(r.session, 0.0) - r.usd)
            if r.cap_id:
                self.cap_held[r.cap_id] = max(0.0, self.cap_held.get(r.cap_id, 0.0) - r.usd)
            if usd <= 0:
                return
            self.spent[r.session] = self.spent.get(r.session, 0.0) + usd
            if r.cap_id:
                self.cap_spent[r.cap_id] = self.cap_spent.get(r.cap_id, 0.0) + usd
            self.path.write_text(json.dumps({"day": self.day, "spent": self.spent, "caps": self.cap_spent}))


GENESIS = hashlib.sha256(b"").hexdigest()


def line_hash(line: str) -> str:
    return hashlib.sha256(line.encode()).hexdigest()


def last_line(path: Path) -> str | None:
    """The last non-empty line of a file, read from the end."""
    try:
        with path.open("rb") as f:
            f.seek(0, os.SEEK_END)
            end = f.tell()
            buf = b""
            while end > 0:
                step = min(65536, end)
                end -= step
                f.seek(end)
                buf = f.read(step) + buf
                lines = buf.rstrip(b"\n").split(b"\n")
                if len(lines) > 1 or end == 0:
                    return lines[-1].decode() if lines[-1] else None
    except FileNotFoundError:
        return None
    return None


def verify_chain(path: Path) -> tuple[int, str | None]:
    """(lines checked, first broken link or None). Each line's `prev_hash` must be
    the sha256 of the line before it (the first: sha256 of nothing)."""
    prev = GENESIS
    n = 0
    with path.open() as f:
        for n, raw in enumerate(f, 1):
            line = raw.rstrip("\n")
            try:
                rec = json.loads(line)
            except ValueError:
                return n, f"line {n}: not JSON"
            if not isinstance(rec, dict) or "prev_hash" not in rec:
                return n, f"line {n}: no prev_hash (written before the chain?)"
            if rec["prev_hash"] != prev:
                return n, f"line {n}: prev_hash {str(rec['prev_hash'])[:12]} does not match line {n - 1} ({prev[:12]})"
            prev = line_hash(line)
    return n, None


class Audit:
    """One JSON line per decision. Never headers, never bodies. Each line
    carries `prev_hash`, the sha256 of the line before it, so an edit, a
    deletion or a reorder breaks the chain at the next line (`tether audit
    verify`). The last line has no successor to vouch for it: that is what
    team mode's signed checkpoints are for. One writer per file: the chain
    head is read once, at start."""

    def __init__(self, path: Path, policy_version: str | None = None) -> None:
        self.path = path
        self.policy_version = policy_version
        self.lock = threading.Lock()
        last = last_line(path)
        self.prev = line_hash(last) if last else GENESIS

    def write(self, **rec: Any) -> None:
        rec = {"ts": now_iso(), **{k: v for k, v in rec.items() if v is not None}}
        if self.policy_version:
            rec["policy_version"] = self.policy_version
        with self.lock, self.path.open("a") as f:
            line = json.dumps({**rec, "prev_hash": self.prev}, separators=(",", ":"))
            f.write(line + "\n")
            self.prev = line_hash(line)
        flag = "DENY " if rec.get("decision") == "deny" else "allow"
        what = rec.get("host") or f"{rec.get('method')} /{rec.get('route')}{rec.get('path', '')}"
        extra = f" ${rec['usd']:.4f}" if rec.get("usd") else ""
        why = f" -- {rec['reason']}" if rec.get("reason") else ""
        ident = [rec.get("sandbox", "-"), rec.get("session", "-")] + [rec[k] for k in ("agent", "tool") if rec.get(k)]
        who = "/".join(ident)
        log(f"{flag} [{who}] {rec.get('kind')} {what}{extra}{why}")


