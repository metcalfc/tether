# Headers that describe one hop, or that we always set ourselves. Credentials
# the agent presents are stripped separately, before ours go on.
HOP = {
    "connection",
    "keep-alive",
    "proxy-authenticate",
    "proxy-authorization",
    "te",
    "trailer",
    "transfer-encoding",
    "upgrade",
    "host",
    "content-length",
    "expect",
}
CRED_HEADERS = ("authorization", "x-api-key", "proxy-authorization")
MAX_BODY = 64 * 1024 * 1024
METER_BODY_LIMIT = 8 * 1024 * 1024
TUNNEL_IDLE_SECS = 300

# Claude Code drops this beta when it holds no OAuth credential of its own --
# which is the whole point here -- and a Max subscription token is not honoured
# without it. Same fix as imp.
OAUTH_BETAS = ("claude-code-20250219", "oauth-2025-04-20")


def log(msg: str) -> None:
    print(f"[tether] {msg}", file=sys.stderr, flush=True)


def today() -> str:
    return dt.date.today().isoformat()


def now_iso() -> str:
    return dt.datetime.now().astimezone().isoformat(timespec="seconds")


# --------------------------------------------------------------------- policy


def resolve_credential(spec: str) -> str:
    """env:NAME, cmd:<shell>, file:PATH. Read once, at start, outside the VM.

    cmd: is the macOS-keychain / 1Password hook, e.g.
      cmd:security find-generic-password -s anthropic -w
      cmd:op read op://dev/anthropic/credential
    """
    if spec.startswith("env:"):
        return os.environ.get(spec[4:], "").strip()
    if spec.startswith("cmd:"):
        r = subprocess.run(spec[4:], shell=True, capture_output=True, text=True)
        return r.stdout.strip() if r.returncode == 0 else ""
    if spec.startswith("file:"):
        p = Path(spec[5:]).expanduser()
        return p.read_text().strip() if p.exists() else ""
    return ""


class Route:
    def __init__(self, name: str, cfg: dict[str, Any]) -> None:
        self.name = name
        self.upstream = urllib.parse.urlsplit(cfg["upstream"])
        self.inject: str = cfg.get("inject", "bearer")
        self.paths: list[str] = cfg.get("paths", ["/*"])
        self.meter = bool(cfg.get("meter", False))
        self.credential = resolve_credential(cfg.get("credential", ""))

    @property
    def host(self) -> str:
        return (self.upstream.hostname or "").lower()

    def allowed(self, path: str) -> bool:
        return any(fnmatch.fnmatchcase(path, p) for p in self.paths)

    def apply(self, headers: dict[str, str]) -> None:
        c = self.credential
        if self.inject == "anthropic":
            if c.startswith("sk-ant-oat"):
                headers["authorization"] = "Bearer " + c
                betas = [b.strip() for b in headers.get("anthropic-beta", "").split(",") if b.strip()]
                for b in OAUTH_BETAS:
                    if b not in betas:
                        betas.append(b)
                headers["anthropic-beta"] = ",".join(betas)
            else:
                headers["x-api-key"] = c
        elif self.inject == "bearer":
            headers["authorization"] = "Bearer " + c
        elif self.inject.startswith("basic:"):
            user = self.inject.split(":", 1)[1]
            headers["authorization"] = "Basic " + base64.b64encode(f"{user}:{c}".encode()).decode()
        else:
            raise ValueError(f"route {self.name}: unknown inject mode {self.inject!r}")


class Sandbox:
    """One machine, one listener. The port a request arrives on says which
    sandbox sent it: the guest can't choose it, so it can't forge it."""

    def __init__(self, name: str, listen: str, advertise: str, sessions: list[str]) -> None:
        self.name = name
        self.listen = listen
        self.advertise = advertise
        self.sessions = sessions


class Policy:
    def __init__(self, path: Path) -> None:
        self.path = path
        cfg = json.loads(path.read_text())
        base = path.parent
        self.listen: str = cfg.get("listen", "0.0.0.0:8080")
        self.advertise: str = cfg.get("advertise", "http://tether:8080")
        self.state_dir = (base / cfg.get("state_dir", "run/tether")).resolve()
        # Without a `sandboxes` map, the top-level listen/advertise/sessions
        # are one sandbox called "default" -- leash's single-listener shape.
        self.sandboxes: dict[str, Sandbox] = {}
        if "sandboxes" in cfg:
            if "sessions" in cfg:
                raise ValueError("policy: list sessions under each sandbox, not at the top level")
            for name, sc in cfg["sandboxes"].items():
                listen = sc["listen"]
                port = listen.rpartition(":")[2]
                adv = sc.get("advertise", f"http://host.microsandbox.internal:{port}")
                self.sandboxes[name] = Sandbox(name, listen, adv, sc.get("sessions", [name]))
        else:
            sessions = cfg.get("sessions", ["default"])
            self.sandboxes["default"] = Sandbox("default", self.listen, self.advertise, sessions)
        self.session_sandbox: dict[str, str] = {}
        for sb in self.sandboxes.values():
            for s in sb.sessions:
                if s in self.session_sandbox:
                    raise ValueError(f"policy: session {s} is in sandboxes {self.session_sandbox[s]} and {sb.name}")
                self.session_sandbox[s] = sb.name
        self.session_names: list[str] = list(self.session_sandbox)
        self.routes: dict[str, Route] = {}
        self.disabled_routes: list[str] = []
        for name, rc in cfg.get("routes", {}).items():
            r = Route(name, rc)
            if r.credential:
                self.routes[name] = r
            else:
                self.disabled_routes.append(name)
        eg = cfg.get("egress", {})
        self.egress_allow: list[str] = [h.lower() for h in eg.get("allow", [])]
        self.egress_ports: set[int] = set(eg.get("ports", [443]))
        sp = cfg.get("spend", {})
        self.cap_session: float | None = sp.get("per_session_usd_per_day")
        self.cap_total: float | None = sp.get("total_usd_per_day")
        self.prices: dict[str, list[float]] = cfg.get("prices_per_mtok", {"default": [5, 25]})


# ------------------------------------------------------- capability registry

CAP_PREFIX = "tth_"


def cap_hash(cap: str) -> str:
    return hashlib.sha256(cap.encode()).hexdigest()


def cap_state(rec: dict[str, Any], now: float | None = None) -> str:
    if rec.get("revoked"):
        return "revoked"
    exp = rec.get("expires")
    if exp is not None and (now if now is not None else time.time()) >= exp:
        return "expired"
    return "live"


def parse_ttl(s: str) -> float:
    """90s, 30m, 8h, 2d -> seconds."""
    units = {"s": 1, "m": 60, "h": 3600, "d": 86400}
    if not s or s[-1] not in units:
        raise ValueError(f"bad ttl {s!r}: use e.g. 90s, 30m, 8h, 2d")
    return float(s[:-1]) * units[s[-1]]


class Registry:
    """Every capability tether has minted: which sandbox it is bound to, who
    holds it (session / agent / tool / human) and what it may do. Kept in
    state_dir/caps.json (0600), keyed by the cap's sha256, so the file never
    holds a usable cap. The CLI writes it; `serve` re-reads it whenever it
    changes, so `tether cap revoke` bites on the next request."""

    def __init__(self, state_dir: Path) -> None:
        state_dir.mkdir(parents=True, exist_ok=True)
        self.path = state_dir / "caps.json"
        self.lockfile = state_dir / "caps.lock"
        self.lock = threading.Lock()
        self.sig: tuple[int, int, int] | None = None
        self.by_hash: dict[str, dict[str, Any]] = {}

    def _sig(self) -> tuple[int, int, int] | None:
        try:
            st = self.path.stat()
        except FileNotFoundError:
            return None
        return st.st_ino, st.st_mtime_ns, st.st_size

    def _load(self) -> None:
        # Writers replace the file, so a new inode means new contents: one
        # stat per request is the whole cost of live revocation.
        sig = self._sig()
        if sig != self.sig:
            self.by_hash = json.loads(self.path.read_text()).get("caps", {}) if sig else {}
            self.sig = sig

    def lookup(self, cap: str) -> dict[str, Any] | None:
        with self.lock:
            self._load()
            return self.by_hash.get(cap_hash(cap))

    def records(self) -> list[dict[str, Any]]:
        with self.lock:
            self._load()
            return sorted(self.by_hash.values(), key=lambda r: r["minted"])

    @contextlib.contextmanager
    def _edit(self) -> Iterator[dict[str, dict[str, Any]]]:
        with self.lockfile.open("a") as lf:
            fcntl.flock(lf, fcntl.LOCK_EX)
            caps = json.loads(self.path.read_text()).get("caps", {}) if self.path.exists() else {}
            yield caps
            tmp = self.path.with_suffix(".tmp")
            tmp.write_text(json.dumps({"caps": caps}, indent=2))
            tmp.chmod(0o600)
            os.replace(tmp, self.path)

    def mint(
        self,
        sandbox: str,
        session: str,
        agent: str | None = None,
        tool: str | None = None,
        human: str | None = None,
        routes: list[str] | None = None,
        egress: list[str] | None = None,
        spend_usd: float | None = None,
        ttl_secs: float | None = None,
    ) -> tuple[str, dict[str, Any]]:
        """A new cap and its record. The cap itself is returned once and
        stored nowhere but where the caller puts it."""
        cap = CAP_PREFIX + secrets.token_urlsafe(24)
        now = time.time()
        rec: dict[str, Any] = {
            "cap_id": "cap_" + secrets.token_hex(6),
            "sandbox": sandbox,
            "session": session,
            "agent": agent,
            "tool": tool,
            "human": human,
            # None means "whatever the ceiling allows"; narrowing is per-cap policy.
            "routes": routes,
            "egress": egress,
            "spend_usd": spend_usd,
            "minted": now,
            "expires": now + ttl_secs if ttl_secs else None,
            "revoked": None,
        }
        with self._edit() as caps:
            caps[cap_hash(cap)] = rec
        return cap, rec

    def revoke(self, match: Callable[[dict[str, Any]], bool]) -> list[dict[str, Any]]:
        out = []
        with self._edit() as caps:
            for rec in caps.values():
                if cap_state(rec) != "revoked" and match(rec):
                    rec["revoked"] = time.time()
                    out.append(rec)
        return out


def env_for(policy: Policy, cap: str, advertise: str | None = None) -> dict[str, str]:
    """What the agent's machine gets. Nothing in here is a credential: each
    value is worthless anywhere but through this gateway, on its own
    sandbox's listener."""
    advertise = advertise or policy.advertise
    adv = urllib.parse.urlsplit(advertise)
    host = adv.netloc
    authed = f"{adv.scheme}://agent:{cap}@{host}"
    env = {
        "TETHER_CAPABILITY": cap,
        "HTTPS_PROXY": authed,
        "HTTP_PROXY": authed,
        "https_proxy": authed,
        "http_proxy": authed,
        "NO_PROXY": adv.hostname or "",
        "no_proxy": adv.hostname or "",
        # Claude Code otherwise phones home for telemetry and updates, which
        # the allowlist would refuse -- noise in the audit log, not a threat.
        "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    }
    if "anthropic" in policy.routes:
        env["ANTHROPIC_BASE_URL"] = f"{advertise}/anthropic"
        env["ANTHROPIC_AUTH_TOKEN"] = cap
    if "openai" in policy.routes:
        env["OPENAI_BASE_URL"] = f"{advertise}/openai/v1"
        env["OPENAI_API_KEY"] = cap
    if "github" in policy.routes:
        # git sees https://github.com/... and quietly talks to the gateway.
        env["GIT_CONFIG_COUNT"] = "1"
        env["GIT_CONFIG_KEY_0"] = f"url.{authed}/github/.insteadOf"
        env["GIT_CONFIG_VALUE_0"] = "https://github.com/"
    if "github-api" in policy.routes:
        env["GH_HOST"] = "github.com"
        env["GITHUB_API_URL"] = f"{advertise}/github-api"
    return env


def write_env_file(policy: Policy, path: Path, cap: str, rec: dict[str, Any]) -> Path:
    sb = policy.sandboxes[rec["sandbox"]]
    who = "/".join(x for x in (rec["session"], rec.get("agent"), rec.get("tool")) if x)
    lines = [f"{k}={v}" for k, v in env_for(policy, cap, sb.advertise).items()]
    body = "\n".join(lines)
    head = f"# tether {rec['cap_id']} for {who} (sandbox {sb.name}) -- capabilities only, no credentials"
    path.write_text(f"{head}\n{body}\n")
    path.chmod(0o600)
    return path


def env_file_cap(path: Path) -> str:
    if path.exists():
        for line in path.read_text().splitlines():
            if line.startswith("TETHER_CAPABILITY="):
                return line.partition("=")[2]
    return ""


def init_caps(
    policy: Policy, reg: Registry, sandboxes: list[str] | None = None, rotate: bool = False
) -> dict[str, str]:
    """One default cap per session (no agent, no tool), delivered as
    state_dir/<session>.env -- leash's shape. Idempotent: a session whose env
    file still holds a live cap keeps it. With `rotate` (a new boot), every
    cap of those sandboxes is revoked first and fresh ones are minted.
    Returns session -> cap for the caps minted now."""
    names = sandboxes or list(policy.sandboxes)
    if rotate:
        reg.revoke(lambda r: r["sandbox"] in names)
    out: dict[str, str] = {}
    for sb in names:
        for session in policy.sandboxes[sb].sessions:
            f = policy.state_dir / f"{session}.env"
            rec = reg.lookup(env_file_cap(f) or "-")
            if rec and cap_state(rec) == "live" and (rec["sandbox"], rec["session"]) == (sb, session):
                continue

            def stale(r: dict[str, Any], s: str = session) -> bool:
                return r["session"] == s and not r.get("agent") and not r.get("tool")

            reg.revoke(stale)
            cap, rec = reg.mint(sb, session)
            write_env_file(policy, f, cap, rec)
            out[session] = cap
    return out


# ------------------------------------------------------------ ledger & audit


class Ledger:
    """Today's spend per session. Persisted so a restart doesn't reset a cap."""

    def __init__(self, path: Path) -> None:
        self.path = path
        self.lock = threading.Lock()
        self.day = today()
        self.spent: dict[str, float] = {}
        if path.exists():
            d = json.loads(path.read_text())
            if d.get("day") == self.day:
                self.spent = d.get("spent", {})

    def _roll(self) -> None:
        if self.day != today():
            self.day, self.spent = today(), {}

    def totals(self, session: str) -> tuple[float, float]:
        with self.lock:
            self._roll()
            return self.spent.get(session, 0.0), sum(self.spent.values())

    def add(self, session: str, usd: float) -> None:
        if usd <= 0:
            return
        with self.lock:
            self._roll()
            self.spent[session] = self.spent.get(session, 0.0) + usd
            self.path.write_text(json.dumps({"day": self.day, "spent": self.spent}))


class Audit:
    """One JSON line per decision. Never headers, never bodies."""

    def __init__(self, path: Path) -> None:
        self.path = path
        self.lock = threading.Lock()

    def write(self, **rec: Any) -> None:
        rec = {"ts": now_iso(), **{k: v for k, v in rec.items() if v is not None}}
        line = json.dumps(rec, separators=(",", ":"))
        with self.lock, self.path.open("a") as f:
            f.write(line + "\n")
        flag = "DENY " if rec.get("decision") == "deny" else "allow"
        what = rec.get("host") or f"{rec.get('method')} /{rec.get('route')}{rec.get('path', '')}"
        extra = f" ${rec['usd']:.4f}" if rec.get("usd") else ""
        why = f" -- {rec['reason']}" if rec.get("reason") else ""
        ident = [rec.get("sandbox", "-"), rec.get("session", "-")] + [rec[k] for k in ("agent", "tool") if rec.get(k)]
        who = "/".join(ident)
        log(f"{flag} [{who}] {rec.get('kind')} {what}{extra}{why}")


# --------------------------------------------------------------------- meter


def price_for(prices: dict[str, list[float]], model: str) -> list[float]:
    m = model.lower()
    best = ""
    for k in prices:
        if k != "default" and m.startswith(k.lower()) and len(k) > len(best):
            best = k
    return prices.get(best) or prices.get("default") or [0, 0]


def cost_usd(prices: dict[str, list[float]], model: str, u: dict[str, int]) -> float:
    inp, out = price_for(prices, model)
    # Cache writes at 1.25x input, reads at 0.1x -- Anthropic's published
    # multipliers. Good enough to cap on; not good enough to invoice from.
    tok = u.get("in", 0) * inp + u.get("cw", 0) * inp * 1.25 + u.get("cr", 0) * inp * 0.10 + u.get("out", 0) * out
    return tok / 1_000_000


class Meter:
    """Reads usage out of a response as it streams past, without buffering
    the stream. Handles Anthropic Messages (JSON or SSE) and OpenAI Chat /
    Responses (JSON or SSE). Counts are taken as the max seen per field, which
    is right for Anthropic's cumulative message_delta usage."""

    FIELDS = {
        "in": ("input_tokens", "prompt_tokens"),
        "out": ("output_tokens", "completion_tokens"),
        "cw": ("cache_creation_input_tokens",),
        "cr": ("cache_read_input_tokens",),
    }

    def __init__(self, sse: bool) -> None:
        self.sse = sse
        self.buf = b""
        self.body = bytearray()
        self.model = ""
        self.usage: dict[str, int] = {}

    def feed(self, chunk: bytes) -> None:
        if self.sse:
            self.buf += chunk
            *lines, self.buf = self.buf.split(b"\n")
            for line in lines:
                self._line(line)
        elif len(self.body) < METER_BODY_LIMIT:
            self.body += chunk

    def finish(self) -> None:
        if self.sse:
            self._line(self.buf)
        elif self.body:
            self._obj(bytes(self.body))

    def _line(self, line: bytes) -> None:
        line = line.rstrip(b"\r")
        if line.startswith(b"data:"):
            self._obj(line[5:].strip())

    def _obj(self, raw: bytes) -> None:
        try:
            o = json.loads(raw)
        except ValueError:
            return
        if not isinstance(o, dict):
            return
        for cand in (o, o.get("message"), o.get("response")):
            if not isinstance(cand, dict):
                continue
            if not self.model and isinstance(cand.get("model"), str):
                self.model = cand["model"]
            us = cand.get("usage")
            if isinstance(us, dict):
                for k, names in self.FIELDS.items():
                    for n in names:
                        v = us.get(n)
                        if isinstance(v, int):
                            self.usage[k] = max(self.usage.get(k, 0), v)


# ------------------------------------------------------------------- gateway


def normalize_path(raw: str) -> str | None:
    p = urllib.parse.unquote(raw)
    if not p.startswith("/") or "\x00" in p or "\\" in p:
        return None
    parts = p.split("/")
    if ".." in parts:
        return None
    n = posixpath.normpath(p)
    return n + ("/" if p.endswith("/") and n != "/" else "")


def pump(a: socket.socket, b: socket.socket) -> tuple[int, int]:
    sent = {a: 0, b: 0}
    socks = [a, b]
    while True:
        r, _, _ = select.select(socks, [], [], TUNNEL_IDLE_SECS)
        if not r:
            break
        for s in r:
            try:
                data = s.recv(65536)
            except OSError:
                data = b""
            if not data:
                return sent[a], sent[b]
            (b if s is a else a).sendall(data)
            sent[s] += len(data)
    return sent[a], sent[b]


# (reason for the audit log, message for the guest)
Refusal = tuple[str, str]


class Gateway:
    def __init__(self, policy: Policy) -> None:
        self.p = policy
        self.caps = Registry(policy.state_dir)
        self.ledger = Ledger(policy.state_dir / "spend.json")
        self.audit = Audit(policy.state_dir / "audit.jsonl")
        self.cred_hosts = {r.host: name for name, r in policy.routes.items()}

    def identify(self, presented: list[str], sandbox: str) -> tuple[dict[str, Any] | None, Refusal | None]:
        """(cap record, refusal) for the caps presented on `sandbox`'s listener.
        A cap that is real but revoked, expired or bound to another sandbox is
        refused outright, not treated as missing. The one place that decides
        whether a cap may be used here."""
        now = time.time()
        for cand in presented:
            rec = self.caps.lookup(cand) if cand else None
            if rec is None:
                continue
            cid, sess = rec["cap_id"], rec["session"]
            state = cap_state(rec, now)
            if state != "live":
                return None, (f"capability {cid} of session {sess} is {state}", f"capability is {state}")
            if rec["sandbox"] != sandbox:
                why = f"capability {cid} of session {sess} is bound to sandbox {rec['sandbox']}, used on {sandbox}"
                return None, (why, "capability is not valid on this sandbox's channel")
            if self.p.session_sandbox.get(sess) != sandbox:
                why = f"capability {cid}: session {sess} is no longer in sandbox {sandbox}'s policy"
                return None, (why, "capability is not valid on this sandbox's channel")
            return rec, None
        return None, None

    def egress_ok(self, host: str, port: int) -> tuple[bool, str]:
        if port not in self.p.egress_ports:
            return False, f"port {port} is not allowed"
        if host in self.cred_hosts:
            return False, f"credentialed host; use the gateway route /{self.cred_hosts[host]}/"
        if any(fnmatch.fnmatchcase(host, pat) for pat in self.p.egress_allow):
            return True, ""
        return False, "host is not on the egress allowlist"

    def cap_check(self, session: str) -> str | None:
        mine, total = self.ledger.totals(session)
        if self.p.cap_session is not None and mine >= self.p.cap_session:
            return f"daily spend cap reached for session {session} (${mine:.2f} of ${self.p.cap_session:.2f})"
        if self.p.cap_total is not None and total >= self.p.cap_total:
            return f"daily spend cap reached for the team (${total:.2f} of ${self.p.cap_total:.2f})"
        return None


def presented_tokens(headers: dict[str, str]) -> list[str]:
    out: list[str] = []
    for k in CRED_HEADERS:
        v = headers.get(k)
        if not v:
            continue
        low = v.lower()
        if low.startswith("bearer "):
            out.append(v[7:].strip())
        elif low.startswith("basic "):
            try:
                user, _, pw = base64.b64decode(v[6:].strip()).decode().partition(":")
            except ValueError:
                continue
            out += [pw, user]
        else:
            out.append(v.strip())
    return out


def who(cap: dict[str, Any] | None) -> dict[str, Any]:
    """The identity fields an audit line carries for a cap (or its absence)."""
    if cap is None:
        return {"session": "-"}
    return {k: cap.get(k) for k in ("session", "agent", "tool", "human", "cap_id")}


def make_handler(gw: Gateway, sandbox: str) -> type[http.server.BaseHTTPRequestHandler]:
    class Handler(http.server.BaseHTTPRequestHandler):
        protocol_version = "HTTP/1.1"
        server_version = "tether"
        sys_version = ""

        def log_message(self, fmt: str, *args: Any) -> None:
            pass

        def _hdrs(self) -> dict[str, str]:
            return {k.lower(): v for k, v in self.headers.items()}

        def _error(self, code: int, etype: str, msg: str, extra: dict[str, str] | None = None) -> None:
            body = json.dumps({"type": "error", "error": {"type": etype, "message": "tether: " + msg}}).encode()
            self.send_response(code)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            for k, v in (extra or {}).items():
                self.send_header(k, v)
            self.send_header("Connection", "close")
            self.close_connection = True
            self.end_headers()
            self.wfile.write(body)

        # ---- egress: CONNECT host:port, allowlisted, audited
        def do_CONNECT(self) -> None:
            cap, refusal = gw.identify(presented_tokens(self._hdrs()), sandbox)
            host, _, port_s = self.path.rpartition(":")
            host = host.strip("[]").lower()
            try:
                port = int(port_s)
            except ValueError:
                self._error(400, "invalid_request_error", "bad CONNECT target")
                return
            rec: dict[str, Any] = {"kind": "egress", "sandbox": sandbox, **who(cap), "host": f"{host}:{port}"}
            if refusal:
                gw.audit.write(decision="deny", reason=refusal[0], **rec)
                self._error(403, "permission_error", refusal[1])
                return
            ok, why = gw.egress_ok(host, port)
            if not ok:
                gw.audit.write(decision="deny", reason=why, **rec)
                self._error(403, "permission_error", f"{host}:{port} refused: {why}")
                return
            # Egress costs a capability like everything else: otherwise any
            # process on the box gets out, and nothing says who it was.
            if cap is None:
                gw.audit.write(decision="deny", reason="bad or missing session capability", **rec)
                self._error(
                    407,
                    "authentication_error",
                    "bad or missing session capability",
                    {"Proxy-Authenticate": 'Basic realm="tether"'},
                )
                return
            try:
                up = socket.create_connection((host, port), timeout=10)
            except OSError as e:
                gw.audit.write(decision="allow", status=502, reason=f"connect failed: {e}", **rec)
                self._error(502, "api_error", f"could not reach {host}:{port}")
                return
            self.send_response(200, "Connection Established")
            self.end_headers()
            self.wfile.flush()
            t0 = time.monotonic()
            try:
                up_bytes, down_bytes = pump(self.connection, up)
            finally:
                up.close()
            self.close_connection = True
            ms = int((time.monotonic() - t0) * 1000)
            gw.audit.write(decision="allow", bytes_up=up_bytes, bytes_down=down_bytes, ms=ms, **rec)

        # ---- credentialed routes: /<route>/<path>
        def _proxy(self) -> None:
            t0 = time.monotonic()
            hdrs = self._hdrs()
            cap, refusal = gw.identify(presented_tokens(hdrs), sandbox)
            if self.path.startswith(("http://", "https://")):
                host = urllib.parse.urlsplit(self.path).hostname
                gw.audit.write(
                    kind="egress",
                    decision="deny",
                    sandbox=sandbox,
                    **who(cap),
                    host=f"{host}:80",
                    reason="plain-http forwarding is not offered",
                )
                self._error(403, "permission_error", "plain-http forwarding is not offered")
                return

            raw_path, _, query = self.path.partition("?")
            path = normalize_path(raw_path)
            if path is None:
                self._error(400, "invalid_request_error", "malformed path")
                return
            _, name, rest = path.split("/", 2) if path.count("/") >= 2 else ("", path.strip("/"), "")
            rest = "/" + rest
            route = gw.p.routes.get(name)
            rec: dict[str, Any] = {
                "kind": "api",
                "route": name,
                "method": self.command,
                "path": rest,
                "sandbox": sandbox,
                **who(cap),
            }
            if route is None:
                gw.audit.write(decision="deny", reason="no such route", **rec)
                self._error(404, "not_found_error", f"no route /{name}/")
                return
            if not route.allowed(rest):
                gw.audit.write(decision="deny", reason="path is not on the route's allowlist", **rec)
                self._error(403, "permission_error", f"{rest} is not allowed on /{name}/")
                return
            if refusal:
                gw.audit.write(decision="deny", reason=refusal[0], **rec)
                self._error(403, "permission_error", refusal[1])
                return
            if cap is None:
                gw.audit.write(decision="deny", reason="bad or missing session capability", **rec)
                extra = {"WWW-Authenticate": 'Basic realm="tether"'} if route.inject.startswith("basic:") else None
                self._error(401, "authentication_error", "bad or missing session capability", extra)
                return
            session = cap["session"]
            if route.meter:
                blocked = gw.cap_check(session)
                if blocked:
                    gw.audit.write(decision="deny", reason=blocked, **rec)
                    # 403, not 429: a 429 is an invitation to retry.
                    self._error(403, "permission_error", blocked)
                    return
            try:
                body = self._read_body()
            except ValueError as e:
                self._error(400, "invalid_request_error", str(e))
                return

            fwd = {k: v for k, v in hdrs.items() if k not in HOP and k not in CRED_HEADERS}
            route.apply(fwd)
            fwd["host"] = route.upstream.netloc
            fwd["accept-encoding"] = "identity"
            if body:
                fwd["content-length"] = str(len(body))
            target = route.upstream.path.rstrip("/") + rest + (f"?{query}" if query else "")
            conn_cls = http.client.HTTPSConnection if route.upstream.scheme == "https" else http.client.HTTPConnection
            conn = conn_cls(route.upstream.hostname or "", route.upstream.port, timeout=600)
            try:
                conn.request(self.command, target, body=body or None, headers=fwd)
                resp = conn.getresponse()
            except OSError as e:
                conn.close()
                gw.audit.write(decision="allow", status=502, reason=f"upstream error: {e}", **rec)
                self._error(502, "api_error", "upstream error")
                return

            meter = Meter("text/event-stream" in (resp.getheader("content-type") or "")) if route.meter else None
            self.send_response(resp.status)
            for k, v in resp.getheaders():
                if k.lower() not in HOP:
                    self.send_header(k, v)
            nobody = self.command == "HEAD" or resp.status in (204, 304) or resp.status < 200
            down = 0
            usd = None
            try:
                if nobody:
                    self.send_header("Content-Length", "0")
                    self.end_headers()
                else:
                    self.send_header("Transfer-Encoding", "chunked")
                    self.end_headers()
                    while True:
                        chunk = resp.read1(65536)
                        if not chunk:
                            break
                        down += len(chunk)
                        if meter:
                            meter.feed(chunk)
                        self.wfile.write(b"%x\r\n" % len(chunk) + chunk + b"\r\n")
                        self.wfile.flush()
            finally:
                conn.close()
                # Charged and recorded before the client sees the end of the
                # response, so the agent's next call can't beat the ledger.
                # Calls already in flight can still overshoot the cap.
                if meter:
                    meter.finish()
                    usd = round(cost_usd(gw.p.prices, meter.model, meter.usage), 6)
                    gw.ledger.add(session, usd)
                    rec.update(model=meter.model or None, tokens=meter.usage or None)
                gw.audit.write(
                    decision="allow",
                    status=resp.status,
                    usd=usd,
                    bytes_up=len(body),
                    bytes_down=down,
                    ms=int((time.monotonic() - t0) * 1000),
                    **rec,
                )
            if not nobody:
                self.wfile.write(b"0\r\n\r\n")
                self.wfile.flush()

        def _read_body(self) -> bytes:
            if "chunked" in (self.headers.get("Transfer-Encoding") or "").lower():
                out = bytearray()
                while True:
                    size = int(self.rfile.readline(65537).split(b";")[0].strip() or b"0", 16)
                    if size == 0:
                        while self.rfile.readline(65537) not in (b"\r\n", b"\n", b""):
                            pass
                        return bytes(out)
                    out += self.rfile.read(size)
                    self.rfile.readline(65537)
                    if len(out) > MAX_BODY:
                        raise ValueError("request body too large")
            n = int(self.headers.get("Content-Length") or 0)
            if n < 0 or n > MAX_BODY:
                raise ValueError("bad Content-Length")
            return self.rfile.read(n) if n else b""

        do_GET = do_POST = do_PUT = do_PATCH = do_DELETE = do_HEAD = _proxy

    return Handler


class Server(socketserver.ThreadingMixIn, http.server.HTTPServer):
    daemon_threads = True
    allow_reuse_address = True

    def handle_error(self, request: Any, client_address: Any) -> None:
        # A client hanging up mid-stream is routine; a traceback per hangup is not.
        exc = sys.exc_info()[1]
        if not isinstance(exc, (BrokenPipeError, ConnectionResetError, TimeoutError)):
            super().handle_error(request, client_address)


def build_servers(policy: Policy) -> tuple[dict[str, Server], Gateway]:
    """One listener per sandbox, all sharing one gateway (ledger, audit, caps)."""
    gw = Gateway(policy)
    srvs: dict[str, Server] = {}
    try:
        for name, sb in policy.sandboxes.items():
            host, _, port = sb.listen.rpartition(":")
            srvs[name] = Server((host or "0.0.0.0", int(port)), make_handler(gw, name))
    except OSError:
        for s in srvs.values():
            s.server_close()
        raise
    return srvs, gw


