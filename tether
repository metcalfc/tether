def normalize_path(raw: str) -> str | None:
    p = urllib.parse.unquote(raw)
    if not p.startswith("/") or "\x00" in p or "\\" in p:
        return None
    parts = p.split("/")
    if ".." in parts:
        return None
    n = posixpath.normpath(p)
    return n + ("/" if p.endswith("/") and n != "/" else "")


def pump(a: socket.socket, b: socket.socket) -> tuple[int, int]:
    sent = {a: 0, b: 0}
    socks = [a, b]
    while True:
        r, _, _ = select.select(socks, [], [], TUNNEL_IDLE_SECS)
        if not r:
            break
        for s in r:
            try:
                data = s.recv(65536)
                # A TLS socket can hold decrypted bytes select() can't see.
                while data and isinstance(s, ssl.SSLSocket) and s.pending():
                    data += s.recv(s.pending())
            except OSError:
                data = b""
            if not data:
                return sent[a], sent[b]
            (b if s is a else a).sendall(data)
            sent[s] += len(data)
    return sent[a], sent[b]


def wants_upgrade(headers: dict[str, str]) -> str | None:
    """The protocol a request asks to switch to (`Connection: upgrade` plus `Upgrade:`), or None."""
    tokens = {t.strip().lower() for t in headers.get("connection", "").split(",")}
    proto = headers.get("upgrade", "").strip()
    return proto if "upgrade" in tokens and proto else None


def read_head(sock: socket.socket) -> tuple[bytes, bytes]:
    """Read a response head off a raw socket: (head through the blank line, bytes after it)."""
    buf = b""
    while b"\r\n\r\n" not in buf:
        if len(buf) > MAX_HEAD:
            raise ValueError("response head too large")
        data = sock.recv(65536)
        if not data:
            raise ValueError("upstream closed before a response")
        buf += data
    head, _, rest = buf.partition(b"\r\n\r\n")
    return head + b"\r\n\r\n", rest


class _Replay(io.RawIOBase):
    """A socket's read side with bytes already taken from it put back in front."""

    def __init__(self, data: bytes, sock: socket.socket) -> None:
        self.data, self.sock = data, sock

    def readable(self) -> bool:
        return True

    def readinto(self, b: Any) -> int:
        if self.data:
            n = min(len(b), len(self.data))
            b[:n], self.data = self.data[:n], self.data[n:]
            return n
        return self.sock.recv_into(b)


class ReplaySocket:
    """Enough of a socket for http.client.HTTPResponse to parse bytes we already read."""

    def __init__(self, data: bytes, sock: socket.socket) -> None:
        self.data, self.sock = data, sock

    def makefile(self, mode: str) -> io.BufferedReader:
        return io.BufferedReader(_Replay(self.data, self.sock))


def buffered_bytes(rfile: Any, sock: socket.socket) -> bytes:
    """Bytes the client sent past its request head that rfile has already buffered, without blocking."""
    old = sock.gettimeout()
    sock.setblocking(False)
    try:
        data = rfile.peek(MAX_HEAD)
        return rfile.read(len(data)) if data else b""
    finally:
        sock.settimeout(old)


def addr_refusal(addr: str, allowed: list[ipaddress.IPv4Network | ipaddress.IPv6Network]) -> str | None:
    """Why a tunnel may not go to `addr`, or None. Only global unicast
    addresses pass, unless the policy allowlists the address: a gateway on the
    host sits on the host's loopback, LAN and VPN, which the guest must not
    reach through it."""
    a = ipaddress.ip_address(addr.partition("%")[0])
    if isinstance(a, ipaddress.IPv6Address) and a.ipv4_mapped:
        a = a.ipv4_mapped
    if any(a in net for net in allowed):
        return None
    if a.is_global and not a.is_multicast:
        return None
    return f"resolves to non-public address {a}"


def recv_exact(sock: socket.socket, n: int) -> bytes:
    buf = b""
    while len(buf) < n:
        chunk = sock.recv(n - len(buf))
        if not chunk:
            raise ValueError("connection closed before a ClientHello")
        buf += chunk
    return buf


def read_client_hello(sock: socket.socket) -> tuple[bytes, bytes]:
    """(raw TLS records, handshake bytes) for the guest's first handshake
    message, which may span several records."""
    raw, hs = b"", b""
    while True:
        head = recv_exact(sock, 5)
        if head[0] != 0x16:
            raise ValueError("not a TLS handshake")
        body = recv_exact(sock, int.from_bytes(head[3:5], "big"))
        raw, hs = raw + head + body, hs + body
        if len(hs) >= 4:
            need = 4 + int.from_bytes(hs[1:4], "big")
            if need > MAX_HELLO:
                raise ValueError("ClientHello too large")
            if len(hs) >= need:
                return raw, hs


def client_hello_sni(hs: bytes) -> str:
    """The host_name in a ClientHello's server_name extension. Fails closed:
    no SNI, an encrypted ClientHello or anything malformed raises ValueError."""
    if not hs or hs[0] != 1:
        raise ValueError("not a ClientHello")
    end = 4 + int.from_bytes(hs[1:4], "big")
    if end > len(hs):
        raise ValueError("malformed ClientHello: truncated")
    pos = 4 + 2 + 32  # header, client_version, random

    def take(n: int, limit: int = end) -> bytes:
        nonlocal pos
        if pos + n > limit:
            raise ValueError("malformed ClientHello")
        out = hs[pos : pos + n]
        pos += n
        return out

    take(take(1)[0])  # session_id
    take(int.from_bytes(take(2), "big"))  # cipher_suites
    take(take(1)[0])  # compression_methods
    ext_end = pos + 2 + int.from_bytes(take(2), "big")
    if ext_end > end:
        raise ValueError("malformed ClientHello")
    sni = None
    while pos < ext_end:
        etype, data = int.from_bytes(take(2, ext_end), "big"), take(int.from_bytes(take(2, ext_end), "big"), ext_end)
        if etype == TLS_EXT_ECH:
            raise ValueError("encrypted ClientHello")
        if etype == TLS_EXT_SNI:
            i = 2
            while i + 3 <= len(data):
                n = int.from_bytes(data[i + 1 : i + 3], "big")
                if data[i] == 0 and i + 3 + n <= len(data):
                    sni = data[i + 3 : i + 3 + n].decode("ascii", "replace").lower()
                i += 3 + n
    if not sni:
        raise ValueError("no SNI")
    return sni


# (reason for the audit log, message for the guest)
Refusal = tuple[str, str]


class Gateway:
    def __init__(self, policy: Policy) -> None:
        self.p = policy
        self.caps = Registry(policy.state_dir)
        self.ledger = Ledger(policy.state_dir / "spend.json")
        self.audit = Audit(policy.state_dir / "audit.jsonl", policy.version)
        self.cred_hosts = {r.host: name for name, r in policy.routes.items()}

    def identify(self, presented: list[str], sandbox: str) -> tuple[dict[str, Any] | None, Refusal | None]:
        """(cap record, refusal) for the caps presented on `sandbox`'s listener.
        A cap that is real but revoked, expired or bound to another sandbox is
        refused outright, not treated as missing. The one place that decides
        whether a cap may be used here."""
        now = time.time()
        for cand in presented:
            rec = self.caps.lookup(cand) if cand else None
            if rec is None:
                continue
            cid, sess = rec["cap_id"], rec["session"]
            state = cap_state(rec, now)
            if state != "live":
                return None, (f"capability {cid} of session {sess} is {state}", f"capability is {state}")
            if rec["sandbox"] != sandbox:
                why = f"capability {cid} of session {sess} is bound to sandbox {rec['sandbox']}, used on {sandbox}"
                return None, (why, "capability is not valid on this sandbox's channel")
            if self.p.session_sandbox.get(sess) != sandbox:
                why = f"capability {cid}: session {sess} is no longer in sandbox {sandbox}'s policy"
                return None, (why, "capability is not valid on this sandbox's channel")
            return rec, None
        return None, None

    def egress_ok(self, host: str, port: int, cap: dict[str, Any] | None = None) -> tuple[bool, str]:
        rule, why = self.egress_check(host, port, cap)
        return why is None, why or ""

    def egress_check(self, host: str, port: int, cap: dict[str, Any] | None = None) -> tuple[str, str | None]:
        """(rule, refusal). The ceiling (policy allowlist) first, then the
        cap's own grant: a host must pass both. The rule names the check
        that decided, for the audit."""
        if port not in self.p.egress_ports:
            return "egress:port", f"port {port} is not allowed"
        if host in self.cred_hosts:
            return "egress:credentialed-host", f"credentialed host; use the gateway route /{self.cred_hosts[host]}/"
        try:
            ipaddress.ip_address(host.partition("%")[0])
            return "egress:ip-literal", "IP literal; CONNECT by name"
        except ValueError:
            pass
        hit = next((i for i, pat in enumerate(self.p.egress_allow) if fnmatch.fnmatchcase(host, pat)), None)
        if hit is None:
            return "egress:allowlist", "host is not on the egress allowlist"
        grant = cap.get("egress") if cap else None
        if grant is not None and not any(fnmatch.fnmatchcase(host, pat) for pat in grant):
            return "cap:egress-grant", f"host is not in capability {cap['cap_id']}'s egress grant"
        return f"egress:allow[{hit}]", None

    def resolve(self, host: str, port: int) -> tuple[list[str], str | None]:
        """Resolve on the host, once. (addresses, refusal): if any address is
        refused, all are, so a round-robin answer can't sneak one through.
        Raises OSError if the name does not resolve."""
        addrs = list(dict.fromkeys(ai[4][0] for ai in socket.getaddrinfo(host, port, type=socket.SOCK_STREAM)))
        for a in addrs:
            why = addr_refusal(a, self.p.egress_addresses)
            if why:
                return addrs, why
        return addrs, None

    def route_ok(self, cap: dict[str, Any], route: str) -> str | None:
        grant = cap.get("routes")
        if grant is not None and route not in grant:
            return f"route {route} not granted to capability {cap['cap_id']}"
        return None

    def admit(self, cap: dict[str, Any], est: float) -> tuple[Reservation | None, str | None, str]:
        """Reserve `est` against the session, the team and the cap's sub-cap."""
        return self.ledger.reserve(
            cap["session"],
            est,
            self.p.cap_session,
            self.p.cap_total,
            self.p.max_inflight,
            cap["cap_id"],
            cap.get("spend_usd"),
        )


def billable(route: Route, method: str, path: str) -> bool:
    """Only a POST that makes a model call is reserved and metered: listing
    models and counting tokens are free, so they hold no reservation and no
    inflight slot."""
    return route.meter and method == "POST" and not path.endswith(FREE_SUFFIXES)


def presented_tokens(headers: dict[str, str]) -> list[str]:
    out: list[str] = []
    for k in CRED_HEADERS:
        v = headers.get(k)
        if not v:
            continue
        low = v.lower()
        if low.startswith("bearer "):
            out.append(v[7:].strip())
        elif low.startswith("basic "):
            try:
                user, _, pw = base64.b64decode(v[6:].strip()).decode().partition(":")
            except ValueError:
                continue
            out += [pw, user]
        else:
            out.append(v.strip())
    return out


def clean_id(v: str | None) -> str | None:
    return v if v and ID_RE.fullmatch(v) else None


def client_ids(headers: dict[str, str]) -> dict[str, str | None]:
    """The client-sent request and session IDs an audit line keeps."""
    return {field: clean_id(headers.get(h)) for h, field in CLIENT_ID_HEADERS.items()}


def upstream_id(get: Callable[[str], str | None]) -> str | None:
    for h in UPSTREAM_ID_HEADERS:
        v = clean_id(get(h))
        if v:
            return v
    return None


def head_header(head: bytes, name: str) -> str | None:
    for line in head.decode("latin-1").split("\r\n")[1:]:
        k, sep, v = line.partition(":")
        if sep and k.strip().lower() == name:
            return v.strip()
    return None


def new_request_id() -> str:
    return "req_" + secrets.token_hex(8)


def who(cap: dict[str, Any] | None) -> dict[str, Any]:
    """The identity fields an audit line carries for a cap (or its absence)."""
    if cap is None:
        return {"session": "-"}
    return {k: cap.get(k) for k in ("session", "agent", "tool", "human", "cap_id")}


class BodyError(Exception):
    """The client's request body is malformed, too large, or stopped short."""


class RequestBody:
    """A client request body, forwarded as it arrives.

    Content-Length bodies go upstream with the same length, chunked bodies are
    re-chunked, so a large `git push` never sits in memory. With buffer=True
    the body is read up front (bounded by MAX_BODY) and sent with a length.
    `sent` counts body bytes taken from the client.
    """

    def __init__(self, rfile: Any, headers: Any, sock: socket.socket, buffer: bool = False) -> None:
        self.rfile = rfile
        self.sock = sock
        self.sent = 0
        self.data: bytes | None = None
        self.chunked = "chunked" in (headers.get("Transfer-Encoding") or "").lower()
        self.length = 0
        if not self.chunked:
            try:
                self.length = int(headers.get("Content-Length") or 0)
            except ValueError:
                raise BodyError("bad Content-Length") from None
            if self.length < 0:
                raise BodyError("bad Content-Length")
        if buffer:
            if self.length > MAX_BODY:
                raise BodyError("request body too large")
            out = bytearray()
            for piece in self._pieces():
                out += piece
                if len(out) > MAX_BODY:
                    raise BodyError("request body too large")
            self.data = bytes(out)
            self.chunked, self.length = False, len(self.data)

    def upload(self) -> Iterator[bytes] | bytes | None:
        if self.data is not None:
            return self.data or None
        if not self.chunked and not self.length:
            return None
        return self._pieces()

    def _pieces(self) -> Iterator[bytes]:
        old = self.sock.gettimeout()
        self.sock.settimeout(BODY_IDLE_SECS)
        try:
            yield from (self._chunks() if self.chunked else self._exactly(self.length))
        except OSError as e:
            raise BodyError(f"client stopped mid-body after {self.sent} bytes: {e}") from None
        finally:
            self.sock.settimeout(old)

    def _exactly(self, n: int) -> Iterator[bytes]:
        while n:
            piece = self.rfile.read(min(n, BODY_CHUNK))
            if not piece:
                raise BodyError(f"client stopped mid-body after {self.sent} bytes")
            n -= len(piece)
            self.sent += len(piece)
            yield piece

    def _chunks(self) -> Iterator[bytes]:
        while True:
            line = self.rfile.readline(65537)
            if not line.endswith(b"\n"):
                raise BodyError(f"client stopped mid-body after {self.sent} bytes")
            try:
                size = int(line.split(b";")[0].strip(), 16)
            except ValueError:
                raise BodyError("malformed chunk size") from None
            if size < 0:
                raise BodyError("malformed chunk size")
            if size == 0:
                # Trailers are dropped: they are hop-by-hop as far as we care.
                while True:
                    t = self.rfile.readline(65537)
                    if t in (b"\r\n", b"\n"):
                        return
                    if not t.endswith(b"\n"):
                        raise BodyError(f"client stopped mid-body after {self.sent} bytes")
            yield from self._exactly(size)
            if self.rfile.readline(65537) not in (b"\r\n", b"\n"):
                raise BodyError("malformed chunk framing")


def make_handler(gw: Gateway, sandbox: str) -> type[http.server.BaseHTTPRequestHandler]:
    class Handler(http.server.BaseHTTPRequestHandler):
        protocol_version = "HTTP/1.1"
        server_version = "tether"
        sys_version = ""

        rid = ""

        def log_message(self, fmt: str, *args: Any) -> None:
            pass

        def parse_request(self) -> bool:
            # One ID per request: on the guest's response, every audit line
            # for it, and nowhere upstream.
            self.rid = new_request_id()
            return super().parse_request()

        def send_response(self, code: int, message: str | None = None) -> None:
            super().send_response(code, message)
            if self.rid:
                self.send_header("x-tether-request-id", self.rid)

        def _audit(self, **rec: Any) -> None:
            gw.audit.write(request_id=self.rid, **rec)

        def _hdrs(self) -> dict[str, str]:
            return {k.lower(): v for k, v in self.headers.items()}

        def _error(self, code: int, etype: str, msg: str, extra: dict[str, str] | None = None) -> None:
            body = json.dumps({"type": "error", "error": {"type": etype, "message": "tether: " + msg}}).encode()
            self.send_response(code)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            for k, v in (extra or {}).items():
                self.send_header(k, v)
            self.send_header("Connection", "close")
            self.close_connection = True
            self.end_headers()
            self.wfile.write(body)

        # ---- egress: CONNECT host:port, allowlisted, audited
        def do_CONNECT(self) -> None:
            cap, refusal = gw.identify(presented_tokens(self._hdrs()), sandbox)
            host, _, port_s = self.path.rpartition(":")
            host = host.strip("[]").lower()
            try:
                port = int(port_s)
            except ValueError:
                self._error(400, "invalid_request_error", "bad CONNECT target")
                return
            rec: dict[str, Any] = {"kind": "egress", "sandbox": sandbox, **who(cap), "host": f"{host}:{port}"}
            if refusal:
                self._audit(decision="deny", rule="cap:identify", reason=refusal[0], **rec)
                self._error(403, "permission_error", refusal[1])
                return
            rule, why = gw.egress_check(host, port, cap)
            if why:
                self._audit(decision="deny", rule=rule, reason=why, **rec)
                self._error(403, "permission_error", f"{host}:{port} refused: {why}")
                return
            # Egress costs a capability like everything else: otherwise any
            # process on the box gets out, and nothing says who it was.
            if cap is None:
                self._audit(decision="deny", rule="cap:missing", reason="bad or missing session capability", **rec)
                self._error(
                    407,
                    "authentication_error",
                    "bad or missing session capability",
                    {"Proxy-Authenticate": 'Basic realm="tether"'},
                )
                return
            # Resolve here and dial the checked address, never the name again:
            # a second lookup could answer differently (DNS rebinding).
            try:
                addrs, why = gw.resolve(host, port)
            except OSError as e:
                self._audit(decision="allow", status=502, rule=rule, reason=f"resolve failed: {e}", **rec)
                self._error(502, "api_error", f"could not resolve {host}")
                return
            if why:
                self._audit(decision="deny", rule="addr", reason=why, addrs=addrs, **rec)
                self._error(403, "permission_error", f"{host}:{port} refused: {why}")
                return
            up, err = None, ""
            for a in addrs:
                try:
                    up = socket.create_connection((a, port), timeout=10)
                    rec["addr"] = a
                    break
                except OSError as e:
                    err = str(e)
            if up is None:
                self._audit(
                    decision="allow", status=502, rule=rule, reason=f"connect failed: {err}", addrs=addrs, **rec
                )
                self._error(502, "api_error", f"could not reach {host}:{port}")
                return
            self.send_response(200, "Connection Established")
            self.end_headers()
            self.wfile.flush()
            self.close_connection = True
            # The tunnel must carry TLS to the host it was opened for: the
            # ClientHello's SNI must equal the CONNECT host. No SNI, an
            # encrypted ClientHello or not-TLS fails closed.
            t0 = time.monotonic()
            try:
                self.connection.settimeout(HELLO_TIMEOUT_SECS)
                raw, hs = read_client_hello(self.connection)
                sni = client_hello_sni(hs)
                self.connection.settimeout(None)
                why = None if sni == host else f"SNI {sni} does not match CONNECT host {host}"
            except (ValueError, OSError) as e:
                why = f"ClientHello refused: {e}"
            if why:
                up.close()
                self._audit(decision="deny", rule="sni", reason=why, **rec)
                return
            try:
                up.sendall(raw)
                up_bytes, down_bytes = pump(self.connection, up)
            finally:
                up.close()
            ms = int((time.monotonic() - t0) * 1000)
            self._audit(
                decision="allow", rule=rule, bytes_up=up_bytes + len(raw), bytes_down=down_bytes, ms=ms, **rec
            )

        # ---- credentialed routes: /<route>/<path>
        def _proxy(self) -> None:
            t0 = time.monotonic()
            hdrs = self._hdrs()
            cap, refusal = gw.identify(presented_tokens(hdrs), sandbox)
            if self.path.startswith(("http://", "https://")):
                host = urllib.parse.urlsplit(self.path).hostname
                self._audit(
                    kind="egress",
                    decision="deny",
                    sandbox=sandbox,
                    **who(cap),
                    host=f"{host}:80",
                    rule="plain-http",
                    reason="plain-http forwarding is not offered",
                )
                self._error(403, "permission_error", "plain-http forwarding is not offered")
                return

            raw_path, _, query = self.path.partition("?")
            path = normalize_path(raw_path)
            if path is None:
                self._error(400, "invalid_request_error", "malformed path")
                return
            _, name, rest = path.split("/", 2) if path.count("/") >= 2 else ("", path.strip("/"), "")
            rest = "/" + rest
            route = gw.p.routes.get(name)
            rec: dict[str, Any] = {
                "kind": "api",
                "route": name,
                "method": self.command,
                "path": rest,
                "sandbox": sandbox,
                **who(cap),
                **client_ids(hdrs),
            }
            if route is None:
                self._audit(decision="deny", rule="route:none", reason="no such route", **rec)
                self._error(404, "not_found_error", f"no route /{name}/")
                return
            if route.inject == "anthropic" and rest == "/api/hello" and self.command in ("HEAD", "GET"):
                # Claude Code's reachability probe: no credential, nothing to
                # forward. Answered here so it needs neither a cap nor a path.
                self._audit(decision="allow", status=200, rule=f"route:{name}:hello", **rec)
                self.send_response(200)
                self.send_header("Content-Length", "0")
                self.end_headers()
                return
            if not route.allowed(rest):
                why = "path is not on the route's allowlist"
                self._audit(decision="deny", rule=f"route:{name}:path", reason=why, **rec)
                self._error(403, "permission_error", f"{rest} is not allowed on /{name}/")
                return
            if refusal:
                self._audit(decision="deny", rule="cap:identify", reason=refusal[0], **rec)
                self._error(403, "permission_error", refusal[1])
                return
            if cap is None:
                self._audit(decision="deny", rule="cap:missing", reason="bad or missing session capability", **rec)
                extra = {"WWW-Authenticate": 'Basic realm="tether"'} if route.inject.startswith("basic:") else None
                self._error(401, "authentication_error", "bad or missing session capability", extra)
                return
            not_granted = gw.route_ok(cap, name)
            if not_granted:
                self._audit(decision="deny", rule="cap:route-grant", reason=not_granted, **rec)
                self._error(403, "permission_error", f"route /{name}/ is not granted to this capability")
                return
            target = route.upstream.path.rstrip("/") + rest + (f"?{query}" if query else "")
            proto = wants_upgrade(hdrs)
            if proto:
                # The meter reads usage out of HTTP bodies; it can't parse
                # WebSocket frames, so an upgrade would step around the cap.
                if route.meter:
                    why = "upgrade is not offered on a metered route"
                    self._audit(decision="deny", rule="route:metered-upgrade", reason=why, **rec)
                    self._error(403, "permission_error", f"upgrade is not offered on metered route /{name}/")
                    return
                if self.headers.get("transfer-encoding") or self.headers.get("content-length", "0").strip() != "0":
                    self._audit(decision="deny", rule="upgrade:body", reason="upgrade with a request body", **rec)
                    self._error(400, "invalid_request_error", "upgrade with a request body is not supported")
                    return
                rec["rule"] = f"route:{name}"
                self._upgrade(route, target, hdrs, proto, rec, t0)
                return
            try:
                body = RequestBody(self.rfile, self.headers, self.connection, buffer=route.meter)
            except BodyError as e:
                self._audit(decision="deny", rule="body", reason=str(e), **rec)
                self._error(400, "invalid_request_error", str(e))
                return
            res = None
            if billable(route, self.command, rest):
                est = reserve_usd(gw.p.prices, body.data)
                res, blocked, spend_rule = gw.admit(cap, est)
                if blocked:
                    est_usd = round(est, 6)
                    self._audit(decision="deny", rule=spend_rule, reason=blocked, reserve_usd=est_usd, **rec)
                    # 403, not 429: a 429 is an invitation to retry.
                    self._error(403, "permission_error", blocked)
                    return
                rec["reserve_usd"] = round(est, 6)
            rec["rule"] = f"route:{name}"
            try:
                self._forward(route, target, hdrs, body, rec, t0, res)
            finally:
                if res:
                    gw.ledger.settle(res, 0)  # no-op once the call has settled

        def _forward(
            self,
            route: Route,
            target: str,
            hdrs: dict[str, str],
            body: RequestBody,
            rec: dict[str, Any],
            t0: float,
            res: Reservation | None,
        ) -> None:
            fwd = {k: v for k, v in hdrs.items() if k not in HOP and k not in CRED_HEADERS}
            route.apply(fwd)
            fwd["host"] = route.upstream.netloc
            fwd["accept-encoding"] = "identity"
            if body.chunked:
                fwd["transfer-encoding"] = "chunked"
            elif body.length:
                fwd["content-length"] = str(body.length)
            conn_cls = http.client.HTTPSConnection if route.upstream.scheme == "https" else http.client.HTTPConnection
            conn = conn_cls(route.upstream.hostname or "", route.upstream.port, timeout=600)
            try:
                conn.request(self.command, target, body=body.upload(), headers=fwd, encode_chunked=body.chunked)
                resp = conn.getresponse()
                rec["upstream_request_id"] = upstream_id(resp.getheader)
            except BodyError as e:
                # The client stopped mid-body: the upstream got a truncated
                # request, and there is nothing sane to answer.
                conn.close()
                self._audit(decision="allow", status=499, reason=str(e), bytes_up=body.sent, **rec)
                self.close_connection = True
                return
            except OSError as e:
                conn.close()
                self._audit(decision="allow", status=502, reason=f"upstream error: {e}", bytes_up=body.sent, **rec)
                self._error(502, "api_error", "upstream error")
                return

            meter = Meter("text/event-stream" in (resp.getheader("content-type") or "")) if res else None
            self.send_response(resp.status)
            for k, v in resp.getheaders():
                if k.lower() not in HOP:
                    self.send_header(k, v)
            nobody = self.command == "HEAD" or resp.status in (204, 304) or resp.status < 200
            down = 0
            usd = None
            aborted = False
            try:
                if nobody:
                    self.send_header("Content-Length", "0")
                    self.end_headers()
                else:
                    self.send_header("Transfer-Encoding", "chunked")
                    self.end_headers()
                    while True:
                        chunk = resp.read1(65536)
                        if not chunk:
                            break
                        down += len(chunk)
                        if meter:
                            meter.feed(chunk)
                        self.wfile.write(b"%x\r\n" % len(chunk) + chunk + b"\r\n")
                        self.wfile.flush()
            except BaseException:
                aborted = True
                self.close_connection = True
                raise
            finally:
                conn.close()
                # Settled before the client sees the end of the response, so
                # the agent's next call can't beat the ledger.
                if meter and res:
                    meter.finish()
                    usd = cost_usd(gw.p.prices, meter.model, meter.usage)
                    if aborted and 200 <= resp.status < 300:
                        floor = floor_usd(gw.p.prices, meter.model, body.sent, down)
                        if floor > usd:
                            usd = floor
                            rec["reason"] = "stream aborted before its usage; billed at the floor"
                    usd = round(usd, 6)
                    gw.ledger.settle(res, usd)
                    rec.update(model=meter.model or None, tokens=meter.usage or None)
                self._audit(
                    decision="allow",
                    status=resp.status,
                    usd=usd,
                    bytes_up=body.sent,
                    bytes_down=down,
                    ms=int((time.monotonic() - t0) * 1000),
                    aborted=aborted or None,
                    **rec,
                )
            if not nobody:
                self.wfile.write(b"0\r\n\r\n")
                self.wfile.flush()

        def _upgrade(
            self, route: Route, target: str, hdrs: dict[str, str], proto: str, rec: dict[str, Any], t0: float
        ) -> None:
            """Open the upstream by hand, keep Upgrade/Connection, and on 101 splice the two sockets."""
            rec["upgrade"] = proto
            self.close_connection = True
            fwd = {k: v for k, v in hdrs.items() if k not in HOP and k not in CRED_HEADERS}
            route.apply(fwd)
            fwd.update(host=route.upstream.netloc, upgrade=proto, connection="Upgrade")
            host = route.upstream.hostname or ""
            tls = route.upstream.scheme == "https"
            port = route.upstream.port or (443 if tls else 80)
            head = f"{self.command} {target} HTTP/1.1\r\n" + "".join(f"{k}: {v}\r\n" for k, v in fwd.items())
            try:
                up = socket.create_connection((host, port), timeout=UPGRADE_CONNECT_SECS)
                if tls:
                    up = ssl.create_default_context().wrap_socket(up, server_hostname=host)
            except OSError as e:
                self._audit(decision="allow", status=502, reason=f"upstream error: {e}", **rec)
                self._error(502, "api_error", "upstream error")
                return
            try:
                try:
                    up.sendall(head.encode("latin-1") + b"\r\n")
                    resp_head, extra = read_head(up)
                    status = int(resp_head.split(b"\r\n", 1)[0].split()[1])
                    rec["upstream_request_id"] = upstream_id(lambda h: head_header(resp_head, h))
                except (OSError, ValueError, IndexError) as e:
                    self._audit(decision="allow", status=502, reason=f"upstream error: {e}", **rec)
                    self._error(502, "api_error", "upstream error")
                    return
                if status == 101:
                    up.settimeout(None)
                    early = buffered_bytes(self.rfile, self.connection)
                    self.connection.sendall(resp_head + extra)
                    if early:
                        up.sendall(early)
                    up_bytes, down_bytes = pump(self.connection, up)
                    self._audit(
                        decision="allow",
                        status=101,
                        bytes_up=len(early) + up_bytes,
                        bytes_down=len(resp_head) + len(extra) + down_bytes,
                        ms=int((time.monotonic() - t0) * 1000),
                        **rec,
                    )
                    return
                # Refused upgrade: relay the answer as an ordinary response.
                resp = http.client.HTTPResponse(ReplaySocket(resp_head + extra, up), method=self.command)  # type: ignore[arg-type]
                resp.begin()
                self.send_response(resp.status)
                for k, v in resp.getheaders():
                    if k.lower() not in HOP:
                        self.send_header(k, v)
                self.send_header("Transfer-Encoding", "chunked")
                self.send_header("Connection", "close")
                self.end_headers()
                down = 0
                while chunk := resp.read1(65536):
                    down += len(chunk)
                    self.wfile.write(b"%x\r\n" % len(chunk) + chunk + b"\r\n")
                self.wfile.write(b"0\r\n\r\n")
                self.wfile.flush()
                self._audit(
                    decision="allow",
                    status=resp.status,
                    reason="upstream refused the upgrade",
                    bytes_down=down,
                    ms=int((time.monotonic() - t0) * 1000),
                    **rec,
                )
            finally:
                up.close()

        do_GET = do_POST = do_PUT = do_PATCH = do_DELETE = do_HEAD = _proxy

    return Handler


class Server(socketserver.ThreadingMixIn, http.server.HTTPServer):
    daemon_threads = True
    allow_reuse_address = True

    def handle_error(self, request: Any, client_address: Any) -> None:
        # A client hanging up mid-stream is routine; a traceback per hangup is not.
        exc = sys.exc_info()[1]
        if not isinstance(exc, (BrokenPipeError, ConnectionResetError, TimeoutError)):
            super().handle_error(request, client_address)


def build_servers(policy: Policy) -> tuple[dict[str, Server], Gateway]:
    """One listener per sandbox, all sharing one gateway (ledger, audit, caps)."""
    gw = Gateway(policy)
    srvs: dict[str, Server] = {}
    try:
        for name, sb in policy.sandboxes.items():
            host, _, port = sb.listen.rpartition(":")
            srvs[name] = Server((host or "0.0.0.0", int(port)), make_handler(gw, name))
    except OSError:
        for s in srvs.values():
            s.server_close()
        raise
    return srvs, gw


