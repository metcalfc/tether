# Copy to overnight/config.env and fill in. Not committed.

# Scratch repo for git push tests (owner/name). Throwaway; agents push agent/* branches here.
SCRATCH_REPO=metcalfc/leash-scratch

# Keychain service names (security find-generic-password -s <name> -w)
ANTHROPIC_KEYCHAIN=leash-anthropic
GITHUB_KEYCHAIN=leash-gh-scratch

# Loop limits
MAX_RUNS=60
MAX_HOURS=10
STALL_RUNS=4            # stop after this many runs with no new commit and no PROGRESS.md change

# Optional: the model Claude Code itself uses for the loop (blank = your default)
LOOP_MODEL=
